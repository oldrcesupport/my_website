# Environment Configuration Template
APP_ENV=development
DEBUG=true
SECRET_KEY=replace-with-a-unique-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1,backend,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=restaurant_ticketing
DB_USER=ticketing_user
DB_PASSWORD=replace-with-a-unique-password
DB_HOST=localhost
DB_PORT=5432

# Localization & Business Time
APP_LOCALE=fa-IR
APP_CURRENCY=TOMAN
BUSINESS_TIMEZONE=Asia/Tehran
BUSINESS_DAY_CUTOFF=00:00:00
CHECKOUT_CUTOFF_MARGIN_MINUTES=5

# Restaurant Defaults
RESTAURANT_NAME=نام رستوران
RESTAURANT_TAGLINE=
RESTAURANT_LOGO=
RESTAURANT_ADDRESS=
RESTAURANT_PHONE=

# Pricing Defaults (Development Demo)
DEV_DEMO_TICKET_PRICE_TOMAN=100000
IS_DEMO_PRICE=true

# Capacity Management
CAPACITY_ENABLED=false
CAPACITY_POLICY=UNCONFIGURED
CAPACITY_LIMIT=

# Payment Provider: ZarinPal
PAYMENT_PROVIDER=zarinpal
ZARINPAL_ENV=sandbox
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
LIVE_PAYMENTS_ENABLED=false
PAYMENT_CALLBACK_URL=http://localhost:8000/api/v1/payments/zarinpal/callback/
FRONTEND_URL=http://localhost:3000

# Security Keys (Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
QR_ENCRYPTION_KEY=replace-with-a-generated-fernet-key
